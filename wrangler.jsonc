{
  "name": "hey-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "HEY",
        "class_name": "HeyStore"
      }
    ]
  },
  "observability": {
    "enabled": false
  },
  "exports": {
    "HeyStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
